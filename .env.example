# ─────────────────────────────────────────────
# WebEase Backend — Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────

# Azure AI Speech (STT + TTS)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Select the OpenAI endpoint tab on your screen to copy the endpoint URL
# Azure AI Foundry (LLM)
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_MODEL=

# Backend Server
BACKEND_HOST=
BACKEND_PORT=

# Allowed CORS origins (comma separated)
CORS_ORIGINS=
